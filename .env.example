# Local development: npm run db:local prints URLs for your OS username.
DATABASE_URL=postgresql://YOUR_OS_USER@127.0.0.1:55439/postgres
TEST_DATABASE_URL=postgresql://YOUR_OS_USER@127.0.0.1:55439/mochi_world_test
DEV_MODE=true
# Exercise real register/sign-in in local mock mode; disables account impersonation.
# AUTH_REQUIRED=true
PORT=8777
HOST=127.0.0.1
MARKET_MODE=mock
# live uses public CoinGecko and keeps missing history unavailable.
# COINGECKO_API_KEY=
GAME_TIMEZONE=America/New_York
TRADING_INTERVAL_MS=300000
COMPETITION_INTERVAL_MS=60000
# PG_BIN=/opt/homebrew/bin
# LOCAL_PG_PORT=55439

# Social world: explicit safe local defaults
MOCK_TOKEN_MODE=true
MOCHI_DIALOGUE_PROVIDER=template
MOCK_MARKET_DATA=true
SOLANA_NETWORK=devnet
MAX_PLAYERS_PER_ROOM=40
MOCHI_TOKEN_DECIMALS=6
MARKETPLACE_FEE_BPS=0
# No policy allocation is assumed when unset.
CADENCE_BUYBACK_BPS=
# Real token mode requires all values and checks mint/cluster at startup:
SOLANA_RPC_URL=
MOCHI_TOKEN_MINT=
CADENCE_TOKEN_MINT=
MOCHI_TREASURY_WALLET=
ALLOW_MAINNET_PAYMENTS=false
# Optional server-only language provider; both key and model required:
# OPENAI_API_KEY=
# MOCHI_DIALOGUE_MODEL=
# Offline reviewed treasury recording only (no transaction signing):
# CADENCE_DEX_PROGRAM_ID=

# Single-process local room storage. Redis adapter is a future deployment step.
MULTIPLAYER_STORAGE=memory

# Per-Mochi gap, plus max 3 environmental bubbles per room per 15-second tick.
MOCHI_AUTONOMOUS_SPEECH_GAP_MS=45000

# Resource rewards: treasury-funded liabilities, never minting per resource.
# Empty production values pause earning. DEV_MODE + MOCK_TOKEN_MODE use test budgets.
MOCHI_DAILY_EARN_CAP_RAW=
RESOURCE_REWARD_DAILY_CAP_RAW=
RESOURCE_REWARD_PRICES_JSON=
RESOURCE_REWARD_MIN_ACCOUNT_AGE_MS=
# Must be a separate wallet from the platform payment treasury.
RESOURCE_REWARD_TREASURY_WALLET=
